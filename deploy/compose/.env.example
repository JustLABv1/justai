# Copy to .env before starting the stack.
# Published images are built for same-origin routing; nginx exposes the single
# public origin and proxies /api/v1 to the backend.

JUSTAI_IMAGE_REPOSITORY=ghcr.io/justlabv1/justai
JUSTAI_VERSION=latest

# PostgreSQL
POSTGRES_IMAGE=pgvector/pgvector:pg17
POSTGRES_DB=justai
POSTGRES_USER=justai
POSTGRES_PASSWORD=replace-with-a-secure-password

# Required backend secrets. In production use unique random values.
JUSTAI_ENV=development
JUSTAI_JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-characters
JUSTAI_ENCRYPTION_KEY=replace-with-a-secure-random-encryption-key
JUSTAI_DEV_SEED=false
JUSTAI_SECURE_COOKIES=false
JUSTAI_COOKIE_SAMESITE=lax
JUSTAI_COOKIE_DOMAIN=

# Public origin and callback URLs. Keep the callback URL identical to the URL
# registered with every OIDC provider.
PUBLIC_HOST=localhost
JUSTAI_FRONTEND_ORIGINS=http://localhost,http://127.0.0.1
JUSTAI_OIDC_REDIRECT_URL=http://localhost/api/v1/auth/oidc/callback
JUSTAI_MCP_OAUTH_REDIRECT_URL=http://localhost/api/v1/mcp/oauth/callback

# Host bindings. The nginx edge is the normal entry point.
EDGE_HTTP_BIND=0.0.0.0
EDGE_HTTP_PORT=80
# These are optional direct-debug bindings and can stay loopback-only.
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8080
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000

# Optional network policy and transcription storage overrides.
JUSTAI_ALLOW_PRIVATE_TARGETS=false
JUSTAI_TRANSCRIPTION_STORAGE_DRIVER=local
# For S3-compatible storage, also set the JUSTAI_TRANSCRIPTION_S3_* variables.
# Optional alternate S3 endpoint for worker containers such as pyannote. This
# endpoint is used only in presigned processing URLs; the regular endpoint must
# remain reachable by browsers. Example for host MinIO with Podman:
# JUSTAI_TRANSCRIPTION_S3_PROCESSING_ENDPOINT=http://host.containers.internal:9000
# Video defaults: 5 GiB upload limit and 4-hour duration limit.
# JUSTAI_TRANSCRIPTION_VIDEO_UPLOAD_MAX_BYTES=5368709120
# JUSTAI_TRANSCRIPTION_VIDEO_UPLOAD_PART_BYTES=16777216
# JUSTAI_TRANSCRIPTION_VIDEO_MAX_DURATION_HOURS=4
# JUSTAI_TRANSCRIPTION_LIVE_STREAM_RECONNECT_SECONDS=5

# Optional self-hosted pyannote service (enable with --profile pyannote).
# HF_TOKEN=hf_your_huggingface_token
# PYANNOTE_MODEL_ID=pyannote/speaker-diarization-3.1
# PYANNOTE_SERVICE_TOKEN=replace-with-an-internal-service-token
# PYANNOTE_ALLOWED_MEDIA_ORIGINS=https://s3.example.com
# Set this only when the exact allowlisted media origin is intentionally
# private (for example a MinIO service reachable only inside the cluster).
# PYANNOTE_ALLOW_PRIVATE_MEDIA_ORIGINS=http://minio:9000
# PYANNOTE_DEVICE=auto
# PYANNOTE_MIN_AUDIO_SECONDS=1
# PYANNOTE_TORCH_THREADS=2
