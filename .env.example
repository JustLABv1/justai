# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# Backend
JUSTAI_PORT=8080
JUSTAI_DATABASE_URL=postgres://justai:justai@localhost:54329/justai?sslmode=disable
JUSTAI_JWT_SECRET=replace-with-a-long-development-secret
JUSTAI_ENCRYPTION_KEY=replace-with-a-long-development-encryption-key
JUSTAI_FRONTEND_ORIGINS=http://localhost:3000
JUSTAI_DEV_SEED=true
JUSTAI_ALLOW_PRIVATE_TARGETS=false
JUSTAI_MCP_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/mcp/oauth/callback

# Optional OIDC
# JUSTAI_OIDC_ISSUER=https://id.example.com
# JUSTAI_OIDC_CLIENT_ID=justai-local
# JUSTAI_OIDC_CLIENT_SECRET=...
# JUSTAI_OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/oidc/callback
